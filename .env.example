# Environment variables template
# Copy this file to .env for local dev.
# On Vercel, set these under Project Settings -> Environment Variables.

# Database (Neon Postgres)
# Use the POOLED connection string (host contains "-pooler") for serverless.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct (non-pooled) URL, used only by `prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Email SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# JWT Secret (generate with: openssl rand -base64 48)
JWT_SECRET=your-super-secret-jwt-key

# Cloudinary (official photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Next.js Configuration (optional)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
